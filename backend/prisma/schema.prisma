// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model University {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  state     String    @default("Telangana")
  createdAt DateTime  @default(now()) @map("created_at")
  colleges  College[]

  @@map("universities")
}

model College {
  id           String     @id @default(uuid())
  universityId String     @map("university_id")
  name         String
  code         String     @unique
  district     String?
  type         String     @default("Private") // Government | Private | Autonomous
  createdAt    DateTime   @default(now()) @map("created_at")
  university   University @relation(fields: [universityId], references: [id])

  @@map("colleges")
}

model Subject {
  id           String           @id @default(uuid())
  name         String
  code         String?
  branch       String
  semester     Int
  subjectType  String           @default("academic") @map("subject_type") // academic | lab | elective
  createdAt    DateTime         @default(now()) @map("created_at")
  contents     AcademicContent[]

  @@unique([code, branch, semester])
  @@map("subjects")
}

model AcademicContent {
  id          String   @id @default(uuid())
  subjectId   String   @map("subject_id")
  title       String
  contentType String   @map("content_type") // notes | video | lab-manual | cheat-sheet | assignment | previous-paper | textbook
  description String?
  unitNumber  Int?     @map("unit_number")
  fileUrl     String?  @map("file_url")   // Public S3 URL
  storagePath String?  @map("storage_path") // S3 key
  createdAt   DateTime @default(now()) @map("created_at")
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("academic_contents")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("general") // general | exam_timetable | govt_job | placement | notice
  branch    String?
  semester  Int?
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model ExamResult {
  id        String   @id @default(uuid())
  subject   String
  code      String?
  internal  Int      @default(0)
  external  Int      @default(0)
  total     Int      @default(0)
  max       Int      @default(100)
  grade     String?
  status    String   @default("Pass")
  branch    String
  semester  Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("exam_results")
}

model Internship {
  id        String   @id @default(uuid())
  company   String
  role      String
  type      String   @default("IT")
  domain    String?
  stipend   String?
  duration  String?
  deadline  String?
  applyLink String?  @map("apply_link")
  status    String   @default("Open")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("internships")
}
