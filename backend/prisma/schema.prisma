generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model University {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  state     String?
  colleges  College[]
  students  Student[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("universities")
}

model College {
  id           String     @id @default(uuid())
  universityId String     @map("university_id")
  university   University @relation(fields: [universityId], references: [id])
  name         String
  code         String     @unique
  logoUrl      String?    @map("logo_url")
  district     String?
  type         String?
  state        String?
  students     Student[]
  admins       Admin[]
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("colleges")
}

model Student {
  id               String    @id @default(uuid())
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  fullNameAadhar   String    @map("full_name_aadhar")
  mobile           String    @unique
  email            String    @unique
  passwordHash     String?   @map("password_hash")
  hallTicket       String    @unique @map("hall_ticket")
  universityId     String?   @map("university_id")
  university       University? @relation(fields: [universityId], references: [id])
  collegeId        String?   @map("college_id")
  college          College?  @relation(fields: [collegeId], references: [id])
  course           String
  branch           String
  semester         Int       @default(1)
  yearOfStudy      Int       @default(1) @map("year_of_study")
  passingYear      Int?      @map("passing_year")
  gender           String?
  state            String?
  profilePicUrl    String?   @map("profile_pic_url")
  idCardUrl        String?   @map("id_card_url")
  role             String    @default("student")
  isMobileVerified Boolean   @default(false) @map("is_mobile_verified")
  isEmailVerified  Boolean   @default(false) @map("is_email_verified")
  verificationStatus String    @default("Pending") @map("verification_status")
  isVerified         Boolean   @default(false) @map("is_verified")
  rejectionReason    String?   @map("rejection_reason")
  rewardPoints     Int       @default(0) @map("reward_points")
  createdAt        DateTime  @default(now()) @map("created_at")
  certificates     Certificate[]
  submissions      ProjectSubmission[]
  applications     InternshipApplication[]
  otpCode          String?   @map("otp_code")
  otpExpiresAt     DateTime? @map("otp_expires_at")

  @@map("students")
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String?
  branch      String
  semester    Int
  subjectType String   @default("academic") @map("subject_type")
  contents    AcademicContent[]
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("subjects")
}

model AcademicContent {
  id          String   @id @default(uuid())
  subjectId   String   @map("subject_id")
  subject     Subject  @relation(fields: [subjectId], references: [id])
  title       String
  contentType String   @map("content_type")
  description String?
  unitNumber  Int?     @map("unit_number")
  fileUrl     String?  @map("file_url")
  storagePath String?  @map("storage_path")
  uploadedBy  String?  @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("academic_contents")
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  body      String
  type      String   @default("general")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model ExamResult {
  id       String  @id @default(uuid())
  subject  String
  code     String?
  internal Int     @default(0)
  external Int     @default(0)
  total    Int     @default(0)
  maxMarks Int     @default(100) @map("max_marks")
  grade    String?
  status   String  @default("Pass")
  semester Int     @default(1)
  branch   String  @default("CSE")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("exam_results")
}

model Internship {
  id        String   @id @default(uuid())
  company   String
  role      String
  type      String
  domain    String?
  stipend   String?
  duration  String?
  deadline  String?
  applyLink String?  @map("apply_link")
  logo      String?
  status    String   @default("Open")
  createdAt DateTime @default(now()) @map("created_at")
  applications InternshipApplication[]

  @@map("internships")
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  body        String
  category    String   @default("general")
  collegeId   String?  @map("college_id")
  branch      String?
  semester    Int?
  publishedBy String   @map("published_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("announcements")
}

model Certificate {
  id             String   @id @default(uuid())
  studentId      String   @map("student_id")
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title          String
  courseName     String?  @map("course_name")
  certificateUrl String?  @map("certificate_url")
  verificationId String   @unique @default(uuid()) @map("verification_id")
  issuedAt       DateTime @default(now()) @map("issued_at")

  @@map("certificates")
}

model Project {
  id             String              @id @default(uuid())
  title          String
  projectType    String              @map("project_type")
  category       String?
  domain         String?
  branch         String?
  description    String?
  toolsRequired  String?             @map("tools_required")
  difficulty     String              @default("medium")
  rewardPoints   Int                 @default(500) @map("reward_points")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  submissions    ProjectSubmission[]

  @@map("projects")
}

model ProjectSubmission {
  id             String   @id @default(uuid())
  studentId      String   @map("student_id")
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  projectId      String   @map("project_id")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadUrl      String?  @map("upload_url")
  status         String   @default("submitted")
  certificateUrl String?  @map("certificate_url")
  rewardPoints   Int      @default(0) @map("reward_points")
  submittedAt    DateTime @default(now()) @map("submitted_at")

  @@map("project_submissions")
}

model InternshipApplication {
  id           String     @id @default(uuid())
  studentId    String     @map("student_id")
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internshipId String     @map("internship_id")
  internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  status       String     @default("applied")
  appliedAt    DateTime   @default(now()) @map("applied_at")

  @@unique([studentId, internshipId])
  @@map("internship_applications")
}

model Admin {
  id        String   @id
  email     String   @unique
  collegeId String   @map("college_id")
  college   College  @relation(fields: [collegeId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model InternshipCourse {
  id               String                 @id @default(uuid()) @db.Uuid
  title            String
  subtitle         String?
  description      String?
  thumbnailUrl     String?                @map("thumbnail_url")
  category         String
  difficulty       String                 @default("beginner")
  durationMinutes  Int?                   @default(0) @map("duration_minutes")
  totalVideos      Int?                   @default(0) @map("total_videos")
  totalAssignments Int?                   @default(0) @map("total_assignments")
  instructorName   String?                @map("instructor_name")
  instructorAvatar String?                @map("instructor_avatar")
  rating           Decimal?               @default(0.0) @db.Decimal(2, 1)
  enrolledCount    Int?                   @default(0) @map("enrolled_count")
  skillsYouLearn   String[]               @default([]) @map("skills_you_learn")
  isApproved       Boolean?               @default(true) @map("is_approved")
  createdBy        String?                @map("created_by") @db.Uuid
  createdAt        DateTime?              @default(now()) @map("created_at")
  sections         CourseSection[]
  videos           CourseVideo[]
  assignments      CourseAssignment[]
  testQuestions    CourseTestQuestion[]
  certificates     CourseCertificate[]
  opportunities    InternshipOpportunity[]

  @@map("internship_courses")
}

model CourseSection {
  id          String             @id @default(uuid()) @db.Uuid
  courseId    String             @map("course_id") @db.Uuid
  course      InternshipCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  orderIndex  Int?               @default(0) @map("order_index")
  videos      CourseVideo[]
  assignments CourseAssignment[]

  @@map("course_sections")
}

model CourseVideo {
  id              String         @id @default(uuid()) @db.Uuid
  sectionId       String         @map("section_id") @db.Uuid
  section         CourseSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  courseId        String         @map("course_id") @db.Uuid
  course          InternshipCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  videoUrl        String         @map("video_url")
  thumbnailUrl    String?        @map("thumbnail_url")
  durationSeconds Int?           @default(0) @map("duration_seconds")
  orderIndex      Int?           @default(0) @map("order_index")
  isPreview       Boolean?       @default(false) @map("is_preview")
  resources       String[]       @default([])

  @@map("course_videos")
}

model CourseAssignment {
  id             String         @id @default(uuid()) @db.Uuid
  sectionId      String         @map("section_id") @db.Uuid
  section         CourseSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  courseId       String         @map("course_id") @db.Uuid
  course         InternshipCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  instructions   String?
  maxScore       Int?           @default(100) @map("max_score")
  orderIndex     Int?           @default(0) @map("order_index")
  dueDate        DateTime?      @map("due_date")
  attachmentUrls String[]       @default([]) @map("attachment_urls")

  @@map("course_assignments")
}

model CourseTestQuestion {
  id                 String           @id @default(uuid()) @db.Uuid
  courseId           String           @map("course_id") @db.Uuid
  course             InternshipCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  question           String
  options            String[]
  correctOptionIndex Int              @map("correct_option_index")
  explanation        String?
  marks              Int?             @default(1)
  orderIndex         Int?             @default(0) @map("order_index")

  @@map("course_test_questions")
}

model StudentCourseProgress {
  id                     String           @id @default(uuid()) @db.Uuid
  studentId              String           @map("student_id") @db.Uuid
  courseId               String           @map("course_id") @db.Uuid
  completedVideoIds      String[]         @default([]) @map("completed_video_ids") @db.Uuid
  submittedAssignmentIds String[]         @default([]) @map("submitted_assignment_ids") @db.Uuid
  status                 String?          @default("not_started")
  testScore              Int?             @map("test_score")
  testMaxScore           Int?             @map("test_max_score")
  testPassed             Boolean?         @default(false) @map("test_passed")
  testAttempts           Int?             @default(0) @map("test_attempts")
  certificateId          String?          @map("certificate_id") @db.Uuid
  enrolledAt             DateTime?        @default(now()) @map("enrolled_at")
  completedAt            DateTime?        @map("completed_at")
  certifiedAt            DateTime?        @map("certified_at")

  @@unique([studentId, courseId])
  @@map("student_course_progress")
}

model AssignmentSubmission {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  assignmentId   String           @map("assignment_id") @db.Uuid
  courseId       String           @map("course_id") @db.Uuid
  submissionText String?          @map("submission_text")
  attachmentUrls String[]         @default([]) @map("attachment_urls")
  score          Int?
  feedback       String?
  isGraded       Boolean?         @default(false) @map("is_graded")
  submittedAt    DateTime?        @default(now()) @map("submitted_at")
  gradedAt       DateTime?        @map("graded_at")

  @@map("assignment_submissions")
}

model CourseCertificate {
  id               String           @id @default(uuid()) @db.Uuid
  studentId        String           @map("student_id") @db.Uuid
  studentName      String           @map("student_name")
  hallTicketNo     String           @map("hall_ticket_no")
  courseId         String           @map("course_id") @db.Uuid
  course           InternshipCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseTitle      String           @map("course_title")
  collegeId        String?          @map("college_id") @db.Uuid
  testScore        Int              @map("test_score")
  testMaxScore     Int              @map("test_max_score")
  issuedAt         DateTime?        @default(now()) @map("issued_at")
  verificationCode String           @unique @map("verification_code")
  pdfUrl           String?          @map("pdf_url")

  @@map("course_certificates")
}

model InternshipOpportunity {
  id                String           @id @default(uuid()) @db.Uuid
  companyName       String           @map("company_name")
  companyLogoUrl    String?          @map("company_logo_url")
  role              String
  description       String?
  type              String?          @default("internship")
  location          String?
  isRemote          Boolean?         @default(false) @map("is_remote")
  duration          String?
  stipend           String?          @default("Unpaid")
  requiredSkills    String[]         @default([]) @map("required_skills")
  preferredCourseIds String[]        @default([]) @map("preferred_course_ids") @db.Uuid
  postedAt          DateTime?        @default(now()) @map("posted_at")
  deadline          DateTime
  applyUrl          String           @map("apply_url")
  isApproved        Boolean?         @default(false) @map("is_approved")
  relatedCourseId   String?          @map("related_course_id") @db.Uuid
  relatedCourse     InternshipCourse? @relation(fields: [relatedCourseId], references: [id])
  postedBy          String?          @map("posted_by") @db.Uuid

  @@map("internship_opportunities")
}

model PlacementJob {
  id              String             @id @default(uuid()) @db.Uuid
  companyName     String             @map("company_name")
  companyLogoUrl  String?            @map("company_logo_url")
  role            String
  description     String?
  jobType         String             @default("fullTime") @map("job_type")
  workMode        String             @default("onsite") @map("work_mode")
  experienceLevel String             @default("fresher") @map("experience_level")
  location        String?
  salaryRange     String?            @map("salary_range")
  qualification   String?
  experience      String?
  shift           String?
  contactInfo     String?            @map("contact_info")
  postedBy        String?            @map("posted_by")
  department      String?
  skills          String[]           @default([])
  tags            String[]           @default([])
  applyUrl        String             @default("") @map("apply_url")
  postedAt        DateTime           @default(now()) @map("posted_at")
  deadline        DateTime?
  isUrgent        Boolean            @default(false) @map("is_urgent")
  isFeatured      Boolean            @default(false) @map("is_featured")
  isApproved      Boolean            @default(true) @map("is_approved")
  createdAt       DateTime           @default(now()) @map("created_at")
  savedJobs       StudentSavedJob[]

  @@map("placement_jobs")
}

model StudentSavedJob {
  id        String       @id @default(uuid()) @db.Uuid
  studentId String       @map("student_id")
  jobId     String       @map("job_id") @db.Uuid
  job       PlacementJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  savedAt   DateTime     @default(now()) @map("saved_at")

  @@unique([studentId, jobId])
  @@map("student_saved_jobs")
}

enum ExamContentType {
  recorded_video  @map("recorded_video")
  study_material  @map("study_material")
  quiz
  mock_test       @map("mock_test")
  previous_paper  @map("previous_paper")
  cheat_sheet     @map("cheat_sheet")

  @@map("exam_content_type")
}

model Exam {
  id          String               @id
  name        String
  fullName    String               @map("full_name")
  description String?
  sortOrder   Int                  @default(0) @map("sort_order")
  contents    ExamContent[]
  rotation    ExamRotationConfig?
  govtJobs    GovtJob[]

  @@map("exams")
}

model ExamContent {
  id               String          @id @default(uuid()) @db.Uuid
  examId           String          @map("exam_id")
  exam             Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  contentType      ExamContentType @map("content_type")
  title            String
  description      String?
  topic            String?
  fileUrl          String?         @map("file_url")
  externalLink     String?         @map("external_link")
  year             Int?
  durationSeconds  Int?            @map("duration_seconds")
  questionCount    Int?            @map("question_count")
  timeLimitMinutes Int?            @map("time_limit_minutes")
  rotationIndex    Int?            @map("rotation_index")
  isDaily          Boolean         @default(false) @map("is_daily")
  isMonthly        Boolean         @default(false) @map("is_monthly")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@map("exam_content")
}

model ExamRotationConfig {
  examId            String   @id @map("exam_id")
  exam              Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  quizRotationStart DateTime @default(dbgenerated("'2026-07-01'::date")) @map("quiz_rotation_start") @db.Date
  mockRotationStart DateTime @default(dbgenerated("'2026-07-01'::date")) @map("mock_rotation_start") @db.Date

  @@map("exam_rotation_config")
}

enum GovtJobSector {
  banking
  railways
  defence
  police
  teaching
  central_civil_services @map("central_civil_services")
  state_psc             @map("state_psc")
  psu_technical          @map("psu_technical")
  healthcare
  judiciary
  postal
  insurance
  other

  @@map("govt_job_sector")
}

model GovtJob {
  id            String        @id @default(uuid()) @db.Uuid
  title         String
  organization  String
  sector        GovtJobSector
  location      String?
  mode          String        @default("Online")
  eligibility   String?
  experience    String?       @default("Fresher")
  vacancies     Int?
  salary        String?
  applyDeadline DateTime?     @map("apply_deadline") @db.Date
  testDate      DateTime?     @map("test_date") @db.Date
  applyLink     String        @map("apply_link")
  prepExamId    String?       @map("prep_exam_id")
  prepExam      Exam?         @relation(fields: [prepExamId], references: [id], onDelete: SetNull)
  postedDate    DateTime      @default(now()) @map("posted_date") @db.Date
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@map("govt_jobs")
}




